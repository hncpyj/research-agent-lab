# Copy this file to .env and fill in your values.
# config.py auto-loads .env at import time (no shell sourcing needed) —
# just save this as .env in the project root and run python normally.

# ── Model APIs: keys stay server-side, never in browser code ───────────────
# API_PROVIDER=gemini        # preferred BYOK provider for new sessions
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...         # GOOGLE_API_KEY also works
# Hosted users without a BYOK key use this shared free-tier route. Gemini's
# free tier still requires the server-side key above.
# SHARED_FREE_PROVIDER=gemini
# SHARED_FREE_MODEL=gemini-3.5-flash-lite
# Model per provider (the settings page remembers one for each):
# API_MODEL=claude-sonnet-4-5
# OPENAI_MODEL=gpt-5
# GEMINI_MODEL=gemini-3.5-flash-lite
# Gemini is called through its OpenAI-compatible endpoint, so no extra SDK is
# needed. A server you run yourself (LM Studio, vLLM, llama.cpp's llama-server)
# is a fourth choice on the settings page — give it an address there, no .env
# edit needed. Calls to a localhost or private address are recorded at $0, so
# they never count against the daily cap.
# OPENAI_BASE_URL=

# Paths to GGUF model files (override defaults in config.py)
LOCAL_MODEL_PATH=C:/models/qwen2.5-14b-instruct-q4_k_m.gguf
EMBED_MODEL_PATH=C:/models/nomic-embed-text-v1.5.Q4_K_M.gguf

# GPU layer counts (tune based on your VRAM headroom)
N_GPU_LAYERS=35
EMBED_N_GPU_LAYERS=33

# API model ("claude-sonnet-4-5" or "claude-opus-4-6")
API_MODEL=claude-sonnet-4-5

# Logging verbosity (DEBUG / INFO / WARNING)
LOG_LEVEL=INFO

# ── Ollama (preferred local backend — tried before the GGUF path above) ────
# These are the defaults; the settings page lists what `ollama list` reports
# and remembers the model, the embedding model and the context window there.
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
# Embeddings for Phase 1 paper ranking (`ollama pull nomic-embed-text`)
# OLLAMA_EMBED_MODEL=nomic-embed-text
# Context window per request. Ollama's own default (2048) silently cut longer
# prompts from the front; 8192 fits llama3.1:8b fully on an 8 GB GPU.
# OLLAMA_NUM_CTX=8192

# ── Paper sources (tools/sources, tools/rate_limit.py) ─────────────────────
# Requests to the same source are spaced a random 20-30 s apart; a source
# that returns a rate-limit response is not contacted again for 7 days.
# PAPER_SOURCES=arxiv,openalex,europepmc,crossref,openreview
# SOURCE_MAX_RESULTS=25
# REQUEST_INTERVAL_MIN_S=20
# REQUEST_INTERVAL_MAX_S=30
# SOURCE_BLOCK_DAYS=7
# Used for Crossref's polite pool and in request User-Agent headers
# CONTACT_EMAIL=
# OpenAlex requires a free key since Feb 2026: https://openalex.org/settings/api
# OPENALEX_API_KEY=
# OpenReview requires an account even to read public papers
# OPENREVIEW_USERNAME=
# OPENREVIEW_PASSWORD=
# Papers must score within this margin of the best match to be reviewed
# RELEVANCE_MARGIN=0.10
# Size cap for a dataset URL in the brief (downloaded once so research
# questions can be checked against its real columns)
# DATASET_MAX_MB=200
# Hosts a brief may download a dataset from. Empty means any public host;
# addresses inside your own network are refused either way.
# DATASET_ALLOWED_HOSTS=who.int,worldbank.org

# ── Phase 1 canon-seeding (tools/semantic_scholar.py) ──────────────────────
# CANON_SEED_ENABLED=1
# CANON_SEED_COUNT=5
# CANON_MIN_CITATIONS=20
# Without a key, requests share one global anonymous pool and are throttled
# under load; a free key gives 1 request/s: https://www.semanticscholar.org/product/api#api-key
# SEMANTIC_SCHOLAR_API_KEY=

# ── Phase 6 experiment runner ───────────────────────────────────────────────
# Interpreter used to run generated experiment scripts. Point this at a
# GPU/CUDA-enabled environment if training needs it — defaults to whichever
# Python is running the app otherwise. Example (conda):
# RUNNER_PYTHON=C:/Users/<you>/.conda/envs/<env-name>/python.exe
#
# Auto-fix attempts per failing script before giving up (0 disables the loop
# entirely — useful if you're hand-editing generated scripts and don't want
# them overwritten by the LLM on the next run).
# RUNNER_MAX_FIX_ATTEMPTS=3
#
# Whether the runner may pip install a generated requirements.txt. Set to 0 to
# keep model-written code from fetching packages; requirement lines that are
# URLs, paths or pip options are refused either way.
# RUNNER_ALLOW_PIP=1

# ── Web UI access and spending ──────────────────────────────────────────────
# The UI has no accounts: anyone who reaches the port can start runs that
# execute code on this machine. Set a long random string here to require it on
# every request (open the UI once with ?token=<value>); run_ui.py refuses to
# bind a non-localhost address without one.
# UI_TOKEN=
#
# Most the Anthropic API may spend in one day (UTC). Past the cap every call is
# answered by the local model and the session records it. 0 = no cap.
# API_DAILY_BUDGET_USD=0

# ── Running this as a hosted service ────────────────────────────────────────
# Only relevant when other people reach this server over the internet. On your
# own machine leave every line here commented out.
#
# Marks this copy as hosted. It changes nothing about how research is done; it
# decides what the server may do on someone else's behalf.
# HOSTED=1
#
# Whether the server may execute code a model wrote. That is the point of the
# tool on your own machine, and remote code execution offered to strangers on a
# shared one, so HOSTED=1 turns it off. Turn it back on only once the runner is
# isolated from everything else on the box.
# ALLOW_CODE_EXECUTION=0
# RUNNER_ALLOW_PIP=0
# USE_API=0
#
# Hostnames this server answers to. Empty means any, which is right on a laptop
# and wrong behind a domain.
# Railway's deployment health check uses healthcheck.railway.app. Include the
# loopback names for the image-level health check as well as the public domain.
# ALLOWED_HOSTS=app.researchagentlab.com,healthcheck.railway.app,127.0.0.1,localhost
#
# Where everything that must survive a deploy is kept: the database, backups
# and the key below. On a container host this must be a mounted volume.
# DATA_DIR=/data
#
# The key that encrypts each user's stored API key, base64 of 32 bytes. Set it
# from the environment on a host whose disk may be replaced between deploys;
# without it a key file is made under DATA_DIR, and losing that file means
# every stored provider key has to be entered again. Generate one with:
#   python -c "import base64,secrets;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
# API_KEY_ENCRYPTION_KEY=
#
# Hosted account email. Keep public signup closed until these are set.
# PUBLIC_APP_URL=https://app.researchagentlab.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=ResearchAgentLab <accounts@researchagentlab.com>
# SMTP_STARTTLS=1
# Railway Free/Trial/Hobby blocks outbound SMTP. Use Resend's HTTPS API there.
# RESEND_API_KEY=re_...
#
# Which proxy addresses may set X-Forwarded-For / X-Forwarded-Proto. Keep it as
# narrow as the host allows; the client address and whether the connection was
# HTTPS are both read from these.
# FORWARDED_ALLOW_IPS=127.0.0.1
